<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="root" prefWidth="390" minWidth="390" maxWidth="390" spacing="0"
      styleClass="island-shell" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.islandfx.IslandController" stylesheets="@island.css">
  <children>
    <HBox fx:id="header" alignment="CENTER_LEFT" spacing="11" prefHeight="64" minHeight="64"
          styleClass="island-header" focusTraversable="true" onMouseClicked="#toggleExpanded" onKeyPressed="#headerKey">
      <children>
        <StackPane prefWidth="38" minWidth="38" prefHeight="38" minHeight="38" maxHeight="38" styleClass="music-badge">
          <children><SVGPath content="M 6 16 C 3 16 2 15 2 13.5 C 2 12 3.5 11 6 11 L 7.5 11 L 7.5 3 L 16 1 L 16 11.5 C 16 13.4 14.5 14.5 12 14.5 C 9.5 14.5 9 13.3 9 12 C 9 10.5 10.5 9.5 13 9.5 L 14.5 9.5 L 14.5 4 L 9 5.4 L 9 13 C 9 14.9 8 16 6 16 Z" styleClass="icon-light"/></children>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="2">
          <children>
            <Label text="Music" styleClass="island-title"/>
            <Label text="WINDOWS MEDIA" styleClass="eyebrow"/>
          </children>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER" spacing="3" styleClass="waveform">
          <children>
            <Rectangle width="2" height="6" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="11" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="16" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="10" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="6" arcWidth="2" arcHeight="2"/>
          </children>
        </HBox>
        <Region minWidth="1" prefHeight="25" maxHeight="25" styleClass="vertical-rule"/>
        <HBox alignment="CENTER" spacing="7">
          <children>
            <SVGPath content="M 2 3 H 18 Q 20 3 20 5 V 12 Q 20 14 18 14 H 2 Q 0 14 0 12 V 5 Q 0 3 2 3 Z M 22 6 H 24 V 11 H 22 Z M 3 6 H 15 V 11 H 3 Z" styleClass="battery-icon"/>
            <Label fx:id="batteryLabel" text="--" styleClass="battery-label"/>
          </children>
        </HBox>
        <SVGPath fx:id="chevron" content="M 1 2 L 5 6 L 9 2" styleClass="chevron"/>
      </children>
    </HBox>
    <VBox fx:id="details" visible="false" managed="false" spacing="10" styleClass="media-details">
      <children>
        <HBox alignment="CENTER_LEFT">
          <children>
            <VBox spacing="3"><children><Label text="NOW IN CONTROL" styleClass="eyebrow,accent"/><Label text="Your active media player" styleClass="details-title"/></children></VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="WINDOWS MEDIA" styleClass="details-tag"/>
          </children>
        </HBox>
        <HBox alignment="CENTER" spacing="21" styleClass="transport-row">
          <children>
            <Button onAction="#previous" styleClass="transport,transport-secondary" accessibleText="Previous track">
              <graphic><SVGPath content="M 1 1 H 3 V 15 H 1 Z M 13 1 L 4 8 L 13 15 Z"/></graphic>
              <tooltip><Tooltip text="Previous track"/></tooltip>
            </Button>
            <Button onAction="#playPause" styleClass="transport,transport-primary" accessibleText="Play or pause">
              <graphic><SVGPath content="M 1 0 L 11 7 L 1 14 Z M 14 1 H 16 V 13 H 14 Z M 19 1 H 21 V 13 H 19 Z"/></graphic>
              <tooltip><Tooltip text="Play / pause"/></tooltip>
            </Button>
            <Button onAction="#next" styleClass="transport,transport-secondary" accessibleText="Next track">
              <graphic><SVGPath content="M 1 1 L 10 8 L 1 15 Z M 11 1 H 13 V 15 H 11 Z"/></graphic>
              <tooltip><Tooltip text="Next track"/></tooltip>
            </Button>
          </children>
        </HBox>
        <Label text="Media keys are sent to Windows" styleClass="footnote"/>
      </children>
    </VBox>
  </children>
</VBox>
