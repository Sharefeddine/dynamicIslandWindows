<?xml version="1.0" encoding="UTF-8"?>
<?import com.islandfx.MascotView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="root" prefWidth="310" prefHeight="44" minWidth="0" minHeight="0" maxWidth="Infinity" maxHeight="Infinity"
      spacing="0" styleClass="island-shell" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.islandfx.IslandController" stylesheets="@island.css">
  <children>
    <HBox fx:id="header" alignment="CENTER_LEFT" spacing="9" prefHeight="44" minHeight="44" maxHeight="44"
          styleClass="island-header" focusTraversable="true" accessibleText="Open or pin the island"
          onMouseClicked="#toggleExpanded" onKeyPressed="#headerKey">
      <children>
        <MascotView fx:id="mascotView"/>
        <VBox alignment="CENTER_LEFT" spacing="1" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="Infinity">
          <children>
            <Label fx:id="mediaTitleLabel" text="Music" minWidth="0" maxWidth="Infinity" styleClass="island-title"/>
            <Label fx:id="mediaSubtitleLabel" text="CONNECTING" minWidth="0" maxWidth="Infinity" styleClass="island-subtitle"/>
          </children>
        </VBox>
        <HBox fx:id="waveform" alignment="CENTER" spacing="2" minWidth="20" styleClass="waveform,muted">
          <children>
            <Rectangle width="2" height="8" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="13" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="17" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="12" arcWidth="2" arcHeight="2"/>
            <Rectangle width="2" height="7" arcWidth="2" arcHeight="2"/>
          </children>
        </HBox>
        <HBox alignment="CENTER" spacing="5">
          <children>
            <Circle radius="4" styleClass="battery-dot"/>
            <Label fx:id="batteryLabel" text="--" styleClass="battery-label"/>
          </children>
        </HBox>
        <SVGPath fx:id="chevron" content="M 1 2 L 5 6 L 9 2" styleClass="chevron"/>
      </children>
    </HBox>
    <VBox fx:id="details" visible="false" managed="false" spacing="0" minHeight="300" prefHeight="300" maxHeight="300"
          styleClass="notch-body">
      <children>
        <HBox alignment="CENTER_LEFT" spacing="7" prefHeight="28" minHeight="28" maxHeight="28">
          <children>
            <Label fx:id="pageTitleLabel" text="Music" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="avatarButton" text="3D: soft" onAction="#toggleAvatar" styleClass="avatar-button" accessibleText="Switch 3D companion style">
              <tooltip><Tooltip text="Switch between the stylized and anatomical 3D companions"/></tooltip>
            </Button>
            <Label fx:id="clockLabel" text="--:--" styleClass="clock-label"/>
            <Button fx:id="previousPageButton" text="‹" onAction="#previousPage" styleClass="page-arrow" accessibleText="Previous section">
              <tooltip><Tooltip text="Previous section"/></tooltip>
            </Button>
            <Button fx:id="nextPageButton" text="›" onAction="#nextPage" styleClass="page-arrow" accessibleText="Next section">
              <tooltip><Tooltip text="Next section"/></tooltip>
            </Button>
          </children>
        </HBox>
        <StackPane fx:id="pageStack" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" minHeight="0">
          <children>
            <VBox fx:id="musicPage" spacing="8" styleClass="page-content">
              <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                  <children>
                    <StackPane prefWidth="58" minWidth="58" prefHeight="58" minHeight="58" maxHeight="58" styleClass="album-placeholder">
                      <children><SVGPath content="M 8 2 L 20 0 L 20 15 C 20 18 18 19 15 19 C 12 19 11 18 11 16 C 11 14 13 13 17 13 L 17 5 L 11 6 L 11 17 C 11 20 9 21 6 21 C 3 21 2 20 2 18 C 2 16 4 15 8 15 Z" styleClass="album-note"/></children>
                    </StackPane>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="Infinity">
                      <children>
                        <Label fx:id="detailTitleLabel" text="Checking Windows media…" styleClass="track-title" maxWidth="Infinity"/>
                        <Label fx:id="detailArtistLabel" text="Windows media session" styleClass="track-subtitle" maxWidth="Infinity"/>
                        <Label fx:id="playbackLabel" text="CHECKING" styleClass="state-tag"/>
                      </children>
                    </VBox>
                  </children>
                </HBox>
                <HBox alignment="CENTER" spacing="8">
                  <children>
                    <Label fx:id="positionLabel" text="--:--" styleClass="time-label"/>
                    <ProgressBar fx:id="mediaProgress" progress="0" HBox.hgrow="ALWAYS" maxWidth="Infinity" mouseTransparent="true" styleClass="media-progress" accessibleText="Playback progress, read only"/>
                    <Label fx:id="durationLabel" text="--:--" styleClass="time-label"/>
                  </children>
                </HBox>
                <HBox alignment="CENTER" spacing="21" styleClass="transport-row">
                  <children>
                    <Button fx:id="previousTrackButton" onAction="#previous" styleClass="transport,transport-secondary" accessibleText="Previous track">
                      <graphic><SVGPath content="M 1 1 H 3 V 15 H 1 Z M 13 1 L 4 8 L 13 15 Z"/></graphic>
                      <tooltip><Tooltip text="Previous track"/></tooltip>
                    </Button>
                    <Button fx:id="playPauseButton" onAction="#playPause" styleClass="transport,transport-primary" accessibleText="Play or pause">
                      <graphic><SVGPath fx:id="playPauseIcon" content="M 2 0 L 14 8 L 2 16 Z"/></graphic>
                      <tooltip><Tooltip text="Play / pause"/></tooltip>
                    </Button>
                    <Button fx:id="nextTrackButton" onAction="#next" styleClass="transport,transport-secondary" accessibleText="Next track">
                      <graphic><SVGPath content="M 1 1 L 10 8 L 1 15 Z M 11 1 H 13 V 15 H 11 Z"/></graphic>
                      <tooltip><Tooltip text="Next track"/></tooltip>
                    </Button>
                  </children>
                </HBox>
              </children>
            </VBox>
            <HBox fx:id="focusPage" visible="false" managed="false" spacing="18" alignment="CENTER_LEFT" styleClass="page-content">
              <children>
                <StackPane prefWidth="96" minWidth="96" prefHeight="96" minHeight="96">
                  <children>
                    <Circle radius="41" styleClass="focus-ring-track"/>
                    <Arc fx:id="focusArc" radiusX="41" radiusY="41" startAngle="90" length="0" type="OPEN" styleClass="focus-ring"/>
                    <Label text="◷" styleClass="focus-symbol"/>
                  </children>
                </StackPane>
                <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                  <children>
                    <Label fx:id="focusTimeLabel" text="25:00" styleClass="focus-time"/>
                    <Label fx:id="focusStatusLabel" text="Ready when you are" styleClass="section-subtitle"/>
                    <HBox spacing="6" alignment="CENTER_LEFT" styleClass="button-row">
                      <children>
                        <Button fx:id="breakButton" text="Break" onAction="#selectBreak" styleClass="pill-button"/>
                        <Button fx:id="focusStartButton" text="Start" onAction="#toggleFocus" styleClass="pill-button,focus-primary"/>
                        <Button fx:id="focusButton" text="Focus" onAction="#selectFocus" styleClass="pill-button"/>
                        <Button fx:id="focusResetButton" text="Reset" onAction="#resetFocus" styleClass="text-button"/>
                      </children>
                    </HBox>
                  </children>
                </VBox>
              </children>
            </HBox>
            <VBox fx:id="waterPage" visible="false" managed="false" spacing="8" styleClass="page-content">
              <children>
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <children>
                    <Label fx:id="waterTotalLabel" text="0" styleClass="water-total"/>
                    <Label fx:id="waterGoalLabel" text="/ 2000 ml today" styleClass="section-subtitle"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="waterReminderButton" text="Reminders off" onAction="#toggleWaterReminder" styleClass="pill-button,water-reminder"/>
                  </children>
                </HBox>
                <ProgressBar fx:id="waterProgress" progress="0" maxWidth="Infinity" styleClass="water-progress" accessibleText="Water goal progress"/>
                <HBox spacing="7" alignment="CENTER_LEFT">
                  <children>
                    <Label text="Goal" styleClass="field-caption"/>
                    <TextField fx:id="waterGoalField" promptText="2000" prefWidth="68" styleClass="small-field" accessibleText="Daily water goal in milliliters"/>
                    <Label text="Glass" styleClass="field-caption"/>
                    <TextField fx:id="glassField" promptText="250" prefWidth="62" styleClass="small-field" accessibleText="Glass size in milliliters"/>
                    <Label text="ml" styleClass="field-caption"/>
                    <Button fx:id="waterSaveButton" text="Save" onAction="#saveWaterSettings" styleClass="text-button"/>
                  </children>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                  <children>
                    <Button fx:id="drinkButton" text="+ 250 ml" onAction="#drink" styleClass="pill-button,water-primary"/>
                    <Button fx:id="waterResetButton" text="Reset today" onAction="#resetWater" styleClass="pill-button"/>
                  </children>
                </HBox>
              </children>
            </VBox>
            <VBox fx:id="shelfPage" visible="false" managed="false" spacing="6" styleClass="page-content">
              <children>
                <HBox alignment="CENTER_LEFT" spacing="8">
                  <children>
                    <Label text="Drop files here or add shortcuts" styleClass="section-subtitle" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="addFilesButton" text="+ Add files" onAction="#chooseFiles" styleClass="pill-button"/>
                  </children>
                </HBox>
                <ListView fx:id="shelfList" prefHeight="75" minHeight="40" VBox.vgrow="ALWAYS" styleClass="notch-list" accessibleText="File shelf"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                  <children>
                    <Button fx:id="openFileButton" text="Open" onAction="#openFile" styleClass="pill-button"/>
                    <Button fx:id="removeFileButton" text="Remove shortcut" onAction="#removeFile" styleClass="text-button"/>
                    <Label text="Original files stay in place" styleClass="tiny-hint"/>
                  </children>
                </HBox>
              </children>
            </VBox>
            <VBox fx:id="tasksPage" visible="false" managed="false" spacing="7" styleClass="page-content">
              <children>
                <HBox spacing="6" alignment="CENTER_LEFT">
                  <children>
                    <TextField fx:id="taskField" promptText="Add a task…" onAction="#addTask" minWidth="0" HBox.hgrow="ALWAYS" styleClass="small-field" accessibleText="New task"/>
                    <TextField fx:id="taskTimeField" promptText="HH:mm" prefWidth="68" styleClass="small-field" accessibleText="Optional task reminder time"/>
                    <Button fx:id="addTaskButton" text="Add" onAction="#addTask" styleClass="pill-button,task-primary"/>
                  </children>
                </HBox>
                <ListView fx:id="taskList" prefHeight="98" minHeight="50" VBox.vgrow="ALWAYS" styleClass="notch-list" accessibleText="Tasks"/>
                <HBox alignment="CENTER_LEFT" spacing="4">
                  <children>
                    <Label text="Local reminder · Island must be open" styleClass="tiny-hint" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="testNotificationButton" text="Test notification" onAction="#testNotification" styleClass="text-button"/>
                  </children>
                </HBox>
              </children>
            </VBox>
            <VBox fx:id="lyricsPage" visible="false" managed="false" spacing="4" styleClass="page-content">
              <children>
                <HBox alignment="CENTER_LEFT" spacing="5">
                  <children>
                    <Label fx:id="lyricsStatusLabel" text="Play a track to find lyrics online." minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="section-subtitle"/>
                    <Button fx:id="onlineLyricsButton" text="Online on" onAction="#toggleOnlineLyrics" styleClass="text-button" accessibleText="Enable or disable online lyric lookup">
                      <tooltip><Tooltip text="When enabled, track title and artist are sent to LRCLIB"/></tooltip>
                    </Button>
                    <Button fx:id="retryLyricsButton" text="Retry" onAction="#retryLyrics" styleClass="text-button"/>
                  </children>
                </HBox>
                <Label fx:id="lyricsMatchLabel" text="LRCLIB · title and artist are sent online" maxWidth="Infinity" styleClass="tiny-hint"/>
                <ListView fx:id="lyricsList" minHeight="60" prefHeight="150" VBox.vgrow="ALWAYS" styleClass="notch-list,lyrics-list" accessibleText="Lyrics in the original language"/>
              </children>
            </VBox>
            <VBox fx:id="adhkarPage" visible="false" managed="false" spacing="4" styleClass="page-content">
              <children>
                <HBox alignment="CENTER_LEFT" spacing="5">
                  <children>
                    <Button fx:id="morningButton" text="الصباح" onAction="#showMorning" styleClass="pill-button,adhkar-period"/>
                    <Button fx:id="eveningButton" text="المساء" onAction="#showEvening" styleClass="pill-button,adhkar-period"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="adhkarIndexLabel" text="1 / 1" styleClass="section-subtitle"/>
                    <Button fx:id="previousDhikrButton" text="‹" onAction="#previousDhikr" styleClass="page-arrow" accessibleText="Previous dhikr"/>
                    <Button fx:id="nextDhikrButton" text="›" onAction="#nextDhikr" styleClass="page-arrow" accessibleText="Next dhikr"/>
                  </children>
                </HBox>
                <ScrollPane fx:id="adhkarScroll" fitToWidth="true" hbarPolicy="NEVER" minHeight="55" prefHeight="125" VBox.vgrow="ALWAYS" styleClass="adhkar-scroll">
                  <content>
                    <VBox spacing="7" minWidth="0" styleClass="adhkar-content">
                      <children>
                        <Label fx:id="adhkarTextLabel" text="" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="adhkar-text"/>
                        <Label fx:id="adhkarCountLabel" text="" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="adhkar-count"/>
                        <Label fx:id="adhkarSourceLabel" text="" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="adhkar-source"/>
                      </children>
                    </VBox>
                  </content>
                </ScrollPane>
                <HBox alignment="CENTER_LEFT" spacing="5">
                  <children>
                    <CheckBox fx:id="morningReminderCheck" text="AM" styleClass="reminder-check" accessibleText="Enable morning adhkar reminder"/>
                    <TextField fx:id="morningTimeField" promptText="07:00" prefWidth="56" styleClass="small-field,reminder-field" accessibleText="Morning reminder time"/>
                    <CheckBox fx:id="eveningReminderCheck" text="PM" styleClass="reminder-check" accessibleText="Enable evening adhkar reminder"/>
                    <TextField fx:id="eveningTimeField" promptText="18:00" prefWidth="56" styleClass="small-field,reminder-field" accessibleText="Evening reminder time"/>
                    <Button fx:id="saveAdhkarButton" text="Save reminders" onAction="#saveAdhkar" styleClass="pill-button,adhkar-save"/>
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </StackPane>
        <HBox fx:id="navigation" alignment="CENTER" spacing="4" prefHeight="31" minHeight="31" maxHeight="31" styleClass="page-navigation">
          <children>
            <Button fx:id="musicTab" text="Music" onAction="#showMusic" styleClass="nav-tab"/>
            <Button fx:id="focusTab" text="Focus" onAction="#showFocus" styleClass="nav-tab"/>
            <Button fx:id="waterTab" text="Water" onAction="#showWater" styleClass="nav-tab"/>
            <Button fx:id="shelfTab" text="Shelf" onAction="#showShelf" styleClass="nav-tab"/>
            <Button fx:id="tasksTab" text="Tasks" onAction="#showTasks" styleClass="nav-tab"/>
            <Button fx:id="lyricsTab" text="Lyrics" onAction="#showLyrics" styleClass="nav-tab"/>
            <Button fx:id="adhkarTab" text="Adhkar" onAction="#showAdhkar" styleClass="nav-tab"/>
          </children>
        </HBox>
        <Label fx:id="noticeLabel" text="Hover to open · click the header to pin" maxWidth="Infinity" minHeight="13" prefHeight="13" maxHeight="13" styleClass="notice-label"/>
      </children>
    </VBox>
  </children>
</VBox>
