name: Windows desktop

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure native Windows app
        run: cmake -S windows -B windows/build -A x64
      - name: Build
        run: cmake --build windows/build --config Release
      - name: Test commands and layout
        run: ctest --test-dir windows/build -C Release --output-on-failure
      - name: Smoke-test native windows
        shell: pwsh
        run: ./tests/native/smoke.ps1 -ExePath windows/build/Release/Island.exe
      - name: Prepare portable package
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Path windows/build/artifact -Force | Out-Null
          Copy-Item windows/build/Release/Island.exe windows/build/artifact/Island.exe
          Copy-Item README.md windows/build/artifact/README.md
      - name: Upload Windows executable
        uses: actions/upload-artifact@v4
        with:
          name: Island-Windows-x64
          path: windows/build/artifact/
          if-no-files-found: error
